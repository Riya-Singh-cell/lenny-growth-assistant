# ==========================================
# The Lenny Growth Assistant - Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Configuration
# Recommended for production / Docker: PostgreSQL with pgvector
# Fallback: SQLite is automatically used if PostgreSQL is not reachable or if configured below.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# To force SQLite local file:
# DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# LLM Provider Configuration
# Supported options: ollama | anthropic | openai
LLM_PROVIDER=ollama

# Ollama Settings (Mandatory local demo model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM Settings (Optional, for cloud evaluation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Embedding & Retrieval Settings
# Options: sentence_transformers (offline, fast local CPU) | ollama
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Or for Ollama embedding:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# Vector Storage Path (for local indexed transcript vectors)
VECTOR_STORE_PATH=./data/vector_store

# CORS Origins (Frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
